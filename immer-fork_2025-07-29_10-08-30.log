    },
    {
      "pattern": "values\\(\\):\\s*IterableIterator<any>",
      "replacement": "values(): MapIterator<any>"
    },
    {
      "pattern": "values\\(\\):\\s*IterableIterator<([^>]+)>",
      "replacement": "values(): MapIterator<$1>"
    },
    {
      "pattern": "entries\\(\\):\\s*IterableIterator<\\[any,\\s*any\\]>",
      "replacement": "entries(): MapIterator<[any, any]>"
    }
  ]
}
```

### Step 8: Apply Set-specific iterator fixes if needed
